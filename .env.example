# ─────────────────────────────────────────────────────────
#  Aetheria Quiz — Environment Variables
#  Copy this file to .env and fill in all values
# ─────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
# SQLite (default — zero config, stores in prisma/dev.db)
DATABASE_URL="file:./dev.db"

# ── NextAuth ──────────────────────────────────────────────
# The public URL of your app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="your-super-secret-key-here"

# ── Google Gemini AI (Optional) ───────────────────────────
# Required for AI quiz generation feature
# Get your API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=""

# ── GitHub OAuth (Optional) ───────────────────────────────
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
